# BIAW production email (Microsoft Graph OAuth — not Gmail password SMTP)
EMAIL_AUTH=microsoft-graph
EMAIL_FROM=support@biaw.com
EMAIL_FROM_NAME=BIAW Support
EMAIL_USER=support@biaw.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false

MICROSOFT_TENANT_ID=your-biaw-tenant-id
MICROSOFT_CLIENT_ID=your-biaw-mail-app-client-id
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=

# Do NOT set EMAIL_PASSWORD for Office 365 (basic auth disabled)

# Server
PORT=5000

# Airtable / Memberstack (existing app vars)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME2=
AIRTABLE_TABLE_NAME3=
AIRTABLE_TABLE_NAME4=
MEMBERSTACK_API_KEY=
